rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // An admin is a signed-in user with a document at admins/{uid} (created in the console).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Every node in the tree has a display name.
    function validNode() {
      return request.resource.data.name is string
        && request.resource.data.name.size() <= 200;
    }

    // grades and all nested sections/subjects/exams: public read, admin write
    match /grades/{path=**} {
      allow read: if true;
      allow create, update: if isAdmin() && validNode();
      allow delete: if isAdmin();
    }

    // Users may only check their own admin status; admins are managed in the console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Anything not matched above is denied.
  }
}
