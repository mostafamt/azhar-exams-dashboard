rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // An admin is a signed-in user whose users/{uid} has role 'admin' (set in the console).
    // TRANSITION: admins/{uid} still counts until every admin is migrated (scripts/migrate-admins.mjs);
    // then drop that branch and the `match /admins/{uid}` block below.
    function isAdmin() {
      return signedIn() && (
        (exists(userPath()) && get(userPath()).data.get('role', '') == 'admin')
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Every node in the tree has a display name.
    function validNode() {
      return request.resource.data.name is string
        && request.resource.data.name.size() <= 200;
    }

    // grades and all nested sections/subjects/exams: public read, admin write
    match /grades/{path=**} {
      allow read: if true;
      allow create, update: if isAdmin() && validNode();
      allow delete: if isAdmin();
    }

    // A multiple-choice question: a body, exactly 4 choices and the index of the correct one.
    function validChoice(choice) {
      return choice is string && choice.size() > 0 && choice.size() <= 300;
    }

    function validMcq() {
      let d = request.resource.data;
      return d.keys().hasOnly(['body', 'choices', 'correctIndex', 'source', 'createdAt', 'updatedAt'])
        && d.body is string && d.body.size() > 0 && d.body.size() <= 1000
        && d.choices is list && d.choices.size() == 4
        && validChoice(d.choices[0]) && validChoice(d.choices[1])
        && validChoice(d.choices[2]) && validChoice(d.choices[3])
        && d.correctIndex is int && d.correctIndex >= 0 && d.correctIndex <= 3
        && (!('source' in d) || d.source == null || d.source is map);
    }

    // Question bank: ids are "q" + a number of at least 2 digits (q01, q02, …, q100, …).
    match /questions/mcq-questions/items/{questionId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && questionId.matches('q(0[1-9]|[1-9][0-9]+)')
        && validMcq();
      allow delete: if isAdmin();
    }

    // A student's profile; grade and section must exist in the tree.
    function validProfile() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.gradeId is string && d.gradeId.size() > 0
        && d.sectionId is string && d.sectionId.size() > 0
        && exists(/databases/$(database)/documents/grades/$(d.gradeId)/sections/$(d.sectionId));
    }

    // One collection for students and admins. Clients can only create themselves as students and
    // can never change role, email or createdAt; admins are promoted in the console.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
          ['name', 'email', 'role', 'gradeId', 'sectionId', 'createdAt', 'updatedAt'])
        && request.resource.data.role == 'student'
        && request.resource.data.email == request.auth.token.email
        && validProfile();
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'gradeId', 'sectionId', 'updatedAt'])
        && validProfile();
      allow delete: if false;
    }

    // TRANSITION: legacy admin records, removed once users/{uid}.role is the only source.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ── 1v1 matches (azhar-exams app: docs/match-plan.md) ──────────────────────────────────
    // Both players move through the questions together: `current` is the shared question and
    // `questionStartedAt` (server time) times it. Each player writes only their own `players.{uid}`.
    // Clients grade themselves, but the rules check every answer against the question's
    // correctIndex, so `correct` and `score` can't be faked. Matches are unranked.

    function isPlayer(d) {
      return signedIn() && request.auth.uid in d.playerIds;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyMyPlayerChanged() {
      return request.resource.data.players.diff(resource.data.players).affectedKeys()
        .hasOnly([request.auth.uid]);
    }

    function validNewPlayer(p) {
      return p.keys().hasOnly(['name', 'answers', 'score', 'left'])
        && p.name is string && p.name.size() > 0 && p.name.size() <= 100
        && p.answers == {} && p.score == 0 && p.left == false;
    }

    function hasAnswered(d, uid) {
      return string(d.current) in d.players[uid].answers;
    }

    // The current question is over: both answered, or its time is up.
    function questionOver(d) {
      return (hasAnswered(d, d.playerIds[0]) && hasAnswered(d, d.playerIds[1]))
        || request.time > d.questionStartedAt + duration.value(d.secondsPerQuestion, 's');
    }

    // I add exactly one answer, for the current question, once, in time (+2 s for latency),
    // graded against the question, with the score raised by exactly that grade.
    function answersCurrentQuestion() {
      let d = resource.data;
      let key = string(d.current);
      let before = d.players[request.auth.uid];
      let after = request.resource.data.players[request.auth.uid];
      let answer = after.answers[key];
      return after.diff(before).affectedKeys().hasOnly(['answers', 'score'])
        && after.answers.diff(before.answers).affectedKeys().hasOnly([key])
        && !hasAnswered(d, request.auth.uid)
        && request.time <= d.questionStartedAt + duration.value(d.secondsPerQuestion + 2, 's')
        && answer.keys().hasOnly(['choice', 'correct', 'ms'])
        && answer.choice is int && answer.choice >= 0 && answer.choice <= 3
        && answer.correct == (answer.choice == d.questions[d.current].correctIndex)
        && answer.ms is int && answer.ms >= 0 && answer.ms <= d.secondsPerQuestion * 1000
        && after.score == before.score + (answer.correct ? 1 : 0);
    }

    function validNewMatch() {
      let d = request.resource.data;
      return d.keys().hasOnly(['mode', 'code', 'queueKey', 'subjectId', 'preset', 'secondsPerQuestion',
          'questions', 'status', 'current', 'questionStartedAt', 'hostId', 'playerIds', 'players',
          'createdAt', 'startedAt', 'finishedAt', 'winnerId', 'rematchId'])
        && d.mode in ['random', 'code']
        && (d.mode == 'code' ? d.code is string && d.code.size() == 6 : d.queueKey is string)
        && d.status == 'waiting'
        && d.current == 0
        && d.questionStartedAt == null
        && d.hostId == request.auth.uid
        && d.playerIds == [request.auth.uid]
        && d.players.keys().hasOnly([request.auth.uid])
        && validNewPlayer(d.players[request.auth.uid])
        && d.questions is list && d.questions.size() >= 1 && d.questions.size() <= 25
        && d.secondsPerQuestion is int && d.secondsPerQuestion >= 5 && d.secondsPerQuestion <= 60
        && d.createdAt == request.time
        && d.winnerId == null && d.rematchId == null;
    }

    match /matches/{matchId} {
      // Waiting matches are visible to everyone signed in (matchmaking and room codes).
      allow read: if signedIn() && (resource.data.status == 'waiting' || isPlayer(resource.data));

      allow create: if signedIn() && validNewMatch();

      // Join: a second player adds only themselves and starts question 0.
      allow update: if signedIn()
        && resource.data.status == 'waiting'
        && resource.data.playerIds.size() == 1
        && !(request.auth.uid in resource.data.playerIds)
        && changedKeys().hasOnly(['status', 'playerIds', 'players', 'startedAt', 'questionStartedAt'])
        && request.resource.data.status == 'playing'
        && request.resource.data.playerIds == resource.data.playerIds.concat([request.auth.uid])
        && onlyMyPlayerChanged()
        && validNewPlayer(request.resource.data.players[request.auth.uid])
        && request.resource.data.startedAt == request.time
        && request.resource.data.questionStartedAt == request.time;

      // Answer the current question.
      allow update: if isPlayer(resource.data)
        && resource.data.status == 'playing'
        && changedKeys().hasOnly(['players'])
        && onlyMyPlayerChanged()
        && answersCurrentQuestion();

      // Move both players to the next question.
      allow update: if isPlayer(resource.data)
        && resource.data.status == 'playing'
        && changedKeys().hasOnly(['current', 'questionStartedAt'])
        && request.resource.data.current == resource.data.current + 1
        && request.resource.data.current < resource.data.questions.size()
        && request.resource.data.questionStartedAt == request.time
        && questionOver(resource.data);

      // Finish after the last question.
      allow update: if isPlayer(resource.data)
        && resource.data.status == 'playing'
        && changedKeys().hasOnly(['status', 'finishedAt', 'winnerId'])
        && request.resource.data.status == 'finished'
        && request.resource.data.finishedAt == request.time
        && resource.data.current == resource.data.questions.size() - 1
        && questionOver(resource.data)
        && (request.resource.data.winnerId == null || request.resource.data.winnerId in resource.data.playerIds);

      // Forfeit: I leave and the match finishes with my opponent as the winner.
      allow update: if isPlayer(resource.data)
        && resource.data.status == 'playing'
        && changedKeys().hasOnly(['players', 'status', 'finishedAt', 'winnerId'])
        && onlyMyPlayerChanged()
        && request.resource.data.players[request.auth.uid].diff(resource.data.players[request.auth.uid])
          .affectedKeys().hasOnly(['left'])
        && request.resource.data.players[request.auth.uid].left == true
        && request.resource.data.status == 'finished'
        && request.resource.data.finishedAt == request.time
        && request.resource.data.winnerId in resource.data.playerIds
        && request.resource.data.winnerId != request.auth.uid;

      // Rematch link, set once.
      allow update: if isPlayer(resource.data)
        && resource.data.status == 'finished'
        && resource.data.rematchId == null
        && changedKeys().hasOnly(['rematchId'])
        && request.resource.data.rematchId is string;

      // The host cancels a search.
      allow delete: if signedIn()
        && resource.data.hostId == request.auth.uid
        && resource.data.status == 'waiting';
    }

    // Anything not matched above is denied.
  }
}
