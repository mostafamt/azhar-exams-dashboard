{
  "name": "azhar-exams-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-azhar \"node --test tests/rules.test.js\"",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "test:functions": "firebase emulators:exec --only auth,firestore,functions --project demo-azhar \"node --test tests/deleteNode.test.js\"",
    "emulators": "firebase emulators:start --project demo-azhar",
    "deploy:functions": "firebase deploy --only functions",
    "cleanup:cloudinary": "node --env-file=.env scripts/cleanup-cloudinary.mjs"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "lucide-react": "^1.59.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "firebase-tools": "^15.34.0",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
