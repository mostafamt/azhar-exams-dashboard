# Copy to .env.local and fill in from Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firestore collection that holds the grade documents
VITE_GRADES_COLLECTION=grades

# Delete through the deleteNode Cloud Function (needs the Blaze plan + `npm run deploy:functions`).
# Otherwise the browser deletes the subtree itself.
VITE_DELETE_WITH_FUNCTION=false

# Dev only: talk to `npm run emulators` instead of production (put this in .env.local)
VITE_USE_EMULATORS=false
