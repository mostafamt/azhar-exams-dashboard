# Copy to .env.local and fill in from Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firestore collection that holds the grade documents
VITE_GRADES_COLLECTION=grades

# Delete through the deleteNode Cloud Function (needs the Blaze plan + `npm run deploy:functions`).
# Otherwise the browser deletes the subtree itself.
VITE_DELETE_WITH_FUNCTION=false

# Dev only: talk to `npm run emulators` instead of production (put this in .env.local)
VITE_USE_EMULATORS=false

# Cloudinary (exam page images). Cloud name: Cloudinary console > Dashboard.
# Upload preset: Settings > Upload > Upload presets > Add upload preset:
#   - Signing mode: Unsigned
#   - Asset folder / folder: azhar-exams
#   - Overwrite: off, Use filename: off, Unique filename: off (the app sends its own random id)
#   - Allowed formats: webp,jpg,png   - Max file size: 5 MB
#   - Return delete token: on (lets the app undo an upload that failed to save)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
